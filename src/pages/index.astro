---
const title = "RLT Music & Film Works";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <style>
    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      text-align: center;
    }

    .container {
      max-width: 700px;
      padding: 20px;
    }

    h1 {
      color: gold;
      font-size: 3rem;
      margin-bottom: 20px;
    }

    p {
      font-size: 1.3rem;
      line-height: 1.6;
    }
  </style>
</head>

<body>
  <div class="container">
    <h1>Site Under Maintenance</h1>
    <p>
      RLT Music & Film Works is currently undergoing scheduled maintenance.
    </p>
    <p>
      Please check back soon.
    </p>
  </div>
</body>
</html>