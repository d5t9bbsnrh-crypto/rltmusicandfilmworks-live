---
const pageTitle = 'The Funk Strut (Radio Version)';
const maxDownloads = 3;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

<style>
  :root {
    --gold: #d4af37;
    --black: #050505;
    --white: #ffffff;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }

  body {
    background: #000;
    color: var(--white);
    font-family: Arial, Helvetica, sans-serif;
  }

  .hero {
    position: relative;

    width: 100%;
    min-height: 100vh;

    background-image:
      linear-gradient(
        rgba(0,0,0,0.03),
        rgba(0,0,0,0.12)
      ),
      url('/images/hero/logos/thefunkstrutradio.png');

    background-size: 30%;
    background-position: center center;
    background-repeat: no-repeat;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;
  }

  .overlay {
    position: relative;

    width: 100%;
    max-width: 1200px;

    margin-left: auto;

    display: flex;
    flex-direction: column;

    align-items: flex-end;

    justify-content: flex-start;

    text-align: right;

    gap: 8px;

    padding-right: 10%;
    padding-top: 8%;
    padding-left: 20px;
  }

  .status {
    font-size: 0.68rem;

    letter-spacing: 2px;

    margin-bottom: 14px;

    color: #ffffff;

    text-shadow:
      0 0 12px rgba(255,255,255,0.5);
  }

  .loader {
    width: 70px;
    height: 70px;

    margin-bottom: 30px;

    border:
      4px solid rgba(255,255,255,0.2);

    border-top:
      4px solid var(--gold);

    border-radius: 50%;

    animation:
      spin 1s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  .download-btn {
    display: none;

    background: #d4af37;
    color: #000;

    padding: 12px 24px;

    font-size: 0.9rem;
    font-weight: bold;

    border-radius: 10px;

    text-decoration: none;

    box-shadow:
      0 0 18px rgba(212,175,55,0.45);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;

    margin-top: 10px;
  }

  .download-btn:hover {
    transform: scale(1.04);

    box-shadow:
      0 0 24px rgba(212,175,55,0.7);
  }

  .limit {
    margin-top: 18px;

    font-size: 0.9rem;

    letter-spacing: 1px;

    color:
      rgba(255,255,255,0.82);
  }

  /* TABLETS */
  @media (max-width: 1024px) {

    .hero {
      background-size: 52%;
    }

    .overlay {
      max-width: 90%;
      padding-right: 8%;
    }

    .status {
      font-size: 0.82rem;
      letter-spacing: 2px;
    }
  }

  /* MOBILE */
  @media (max-width: 768px) {

    .hero {
      background-size: 58%;
      background-position: center 18%;
    }

    .overlay {
      padding-right: 4%;
      padding-top: 18%;
    }

    .status {
      font-size: 0.72rem;

      letter-spacing: 2px;

      line-height: 1.5;
    }

    .loader {
      width: 58px;
      height: 58px;
    }

    .download-btn {
      width: 100%;
      max-width: 260px;

      font-size: 0.82rem;

      padding: 12px 16px;
    }

    .limit {
      font-size: 0.78rem;
      line-height: 1.4;
    }
  }

  /* SMALL PHONES */
  @media (max-width: 480px) {

    .hero {
      background-size: 64%;
    }

    .status {
      font-size: 0.66rem;
      letter-spacing: 1px;
    }

    .download-btn {
      font-size: 0.78rem;
      padding: 10px 14px;
    }

    .limit {
      font-size: 0.68rem;
    }
  }

  /* LANDSCAPE PHONES */
  @media
  (max-height: 500px)
  and (orientation: landscape) {

    .hero {
      background-size: 28%;

      padding-top: 40px;
      padding-bottom: 40px;
    }

    .overlay {
      transform: scale(0.92);
    }

    .status {
      margin-bottom: 10px;
    }

    .loader {
      width: 48px;
      height: 48px;

      margin-bottom: 18px;
    }

    .limit {
      margin-top: 12px;
    }
  }
</style>
  </head>

  <body>

    <section class="hero">

      <div class="overlay">

        <div
          id="status"
          class="status"
        >
          PREPARING YOUR DOWNLOAD...
        </div>

        <div
          id="loader"
          class="loader"
        ></div>

        <a
          id="downloadBtn"
          class="download-btn"
          href="/downloads/The-Funk-Strut-radio.zip"
          download
        >
          DOWNLOAD NOW
        </a>

       <div class="limit">
  Maximum Attempts Allowed: 3
</div>

</div>

</section>

<script>
  const status =
    document.getElementById("status");

  const loader =
    document.getElementById("loader");

  const downloadBtn =
    document.getElementById("downloadBtn");

  let hasDownloaded = false;

  // SHOW BUTTON AFTER 4 SECONDS
  setTimeout(() => {

    loader.style.display = "none";

    downloadBtn.style.display =
      "inline-block";

    status.textContent = "";

  }, 4000);

  downloadBtn.addEventListener(
  "click",
  (event) => {

    event.preventDefault();

    if (hasDownloaded) return;

    hasDownloaded = true;

    downloadBtn.disabled = true;

    status.textContent =
      "PREPARING SECURE DOWNLOAD...";

    setTimeout(() => {

      // START DOWNLOAD
      window.open(
        "/downloads/The-Funk-Strut-radio.zip",
        "_blank"
      );

      status.innerHTML =
        "DOWNLOAD COMPLETE<br>RETURNING TO HOME PAGE...";

      setTimeout(() => {
        window.location.href = "/";
      }, 3000);

    }, 2000);

  }
);
</script>

  </body>
</html>
```
