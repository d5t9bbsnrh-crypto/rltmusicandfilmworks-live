---
const pageTitle = 'The Funk Strut (12-Inch Version)';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>

    <style>
      :root { --gold: #d4af37; --white: #fff; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; min-height: 100%; overflow-x: hidden; }
      body { background: #000; color: var(--white); font-family: Arial, Helvetica, sans-serif; }
      .hero {
        width: 100%; min-height: 100vh; padding: 20px;
        background-image: linear-gradient(rgba(0,0,0,.03), rgba(0,0,0,.12)), url('/images/hero/logos/thefunkstrut12inch.png');
        background-size: 30%; background-position: center; background-repeat: no-repeat;
        display: flex; align-items: center; justify-content: center;
      }
      .overlay {
        width: 100%; max-width: 1200px; margin-left: auto;
        display: flex; flex-direction: column; align-items: flex-end; text-align: right;
        gap: 12px; padding-right: 10%; padding-top: 8%; padding-left: 20px;
      }
      .status { font-size: .78rem; letter-spacing: 2px; color: #fff; text-shadow: 0 0 12px rgba(255,255,255,.5); line-height: 1.5; }
      .loader {
        width: 64px; height: 64px; border: 4px solid rgba(255,255,255,.2);
        border-top: 4px solid var(--gold); border-radius: 50%; animation: spin 1s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      .download-btn, .return-link {
        display: none; background: var(--gold); color: #000; padding: 12px 24px;
        font-size: .9rem; font-weight: bold; border-radius: 10px; text-decoration: none;
        box-shadow: 0 0 18px rgba(212,175,55,.45); margin-top: 8px;
      }
      .return-link { background: transparent; color: var(--gold); box-shadow: none; padding-right: 0; }
      .notice { margin-top: 8px; font-size: .85rem; color: rgba(255,255,255,.82); }
      @media (max-width: 1024px) { .hero { background-size: 52%; } .overlay { max-width: 90%; padding-right: 8%; } }
      @media (max-width: 768px) {
        .hero { background-size: 58%; background-position: center 18%; }
        .overlay { padding-right: 4%; padding-top: 18%; }
        .download-btn { width: 100%; max-width: 260px; text-align: center; }
      }
      @media (max-width: 480px) { .hero { background-size: 64%; } }
    </style>
  </head>

  <body>
    <section class="hero">
      <div class="overlay">
        <div id="status" class="status">VERIFYING YOUR PAYMENT...</div>
        <div id="loader" class="loader"></div>
        <a id="downloadBtn" class="download-btn" href="#">DOWNLOAD NOW</a>
        <a id="returnLink" class="return-link" href="/store">RETURN TO STORE</a>
        <div id="notice" class="notice"></div>
      </div>
    </section>

    <iframe id="downloadFrame" title="Secure download" style="display:none"></iframe>

    <script>
      const status = document.getElementById("status");
      const loader = document.getElementById("loader");
      const downloadBtn = document.getElementById("downloadBtn");
      const returnLink = document.getElementById("returnLink");
      const notice = document.getElementById("notice");
      const downloadFrame = document.getElementById("downloadFrame");
      const sessionId = new URLSearchParams(window.location.search).get("session_id");

      async function verifyPayment() {
        if (!sessionId || !sessionId.startsWith("cs_")) {
          loader.style.display = "none";
          status.textContent = "PAYMENT VERIFICATION REQUIRED";
          notice.textContent = "Please complete your purchase through Stripe before downloading.";
          returnLink.style.display = "inline-block";
          return;
        }

        const verifyUrl = `/api/download?product=12inch&verify=1&session_id=${encodeURIComponent(sessionId)}`;
        const downloadUrl = `/api/download?product=12inch&session_id=${encodeURIComponent(sessionId)}`;

        try {
          const response = await fetch(verifyUrl, { cache: "no-store" });
          if (!response.ok) {
            const message = await response.text();
            throw new Error(message || "Payment verification failed.");
          }

          loader.style.display = "none";
          status.textContent = "PAYMENT VERIFIED";
          notice.textContent = "Thank you for your purchase. This purchase allows one download.";
          downloadBtn.href = downloadUrl;
          downloadBtn.style.display = "inline-block";
        } catch (error) {
          loader.style.display = "none";
          status.textContent = "PAYMENT COULD NOT BE VERIFIED";
          notice.textContent = error.message || "Please contact RLT Music & Film Works for assistance.";
          returnLink.style.display = "inline-block";
        }
      }

      downloadBtn.addEventListener("click", (event) => {
        event.preventDefault();
        const downloadUrl = downloadBtn.href;
        downloadBtn.style.display = "none";
        status.textContent = "DOWNLOAD STARTED";
        notice.textContent = "Your one-time download is starting. Returning you to the RLT store...";
        downloadFrame.src = downloadUrl;

        setTimeout(() => {
          window.location.replace("/store");
        }, 4000);
      });

      verifyPayment();
    </script>
  </body>
</html>
